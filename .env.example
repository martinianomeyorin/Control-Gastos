# OAuth 2.0 Client ID/Secret from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this to https://YOUR-DOMAIN/api/auth/google/callback in production.
# Locally, use http://localhost:5173/api/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Generate a random value of at least 32 characters.
SESSION_SECRET=
CRON_SECRET=
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# Leave Turso unset for local SQLite at ./data/control-gastos.db.
# In Vercel, use a Turso database URL and its auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
